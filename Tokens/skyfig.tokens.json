{
  "$schema": "../Schema/skyfig.tokens.schema.json",
  "defaultTheme": "light",
  "name": "Skyfig Example",
  "schemaVersion": "1.0.0",
  "themes": [
    "light",
    "dark"
  ],
  "tokens": {
    "borderWidths": {
      "focus": {
        "description": "Focus ring width",
        "value": 2
      },
      "thin": {
        "value": 1
      }
    },
    "colors": {
      "accent": {
        "description": "Legacy primitive bridge token; prefer action.primary in app UI",
        "values": {
          "dark": "#7DD3FCFF",
          "light": "#0369A1FF"
        }
      },
      "action.onPrimary": {
        "description": "Content shown on a primary action surface",
        "values": {
          "dark": "#0F172AFF",
          "light": "#FFFFFFFF"
        }
      },
      "action.primary": {
        "description": "Primary interactive action surface",
        "values": {
          "dark": "#7DD3FCFF",
          "light": "#0369A1FF"
        }
      },
      "focus.ring": {
        "description": "Keyboard and accessibility focus indicator",
        "values": {
          "dark": "#7DD3FCFF",
          "light": "#0284C7FF"
        }
      },
      "status.danger": {
        "description": "Destructive outcome or error status",
        "values": {
          "dark": "#FCA5A5FF",
          "light": "#B91C1CFF"
        }
      },
      "status.info": {
        "description": "Informational status",
        "values": {
          "dark": "#93C5FDFF",
          "light": "#1D4ED8FF"
        }
      },
      "status.success": {
        "description": "Successful outcome status",
        "values": {
          "dark": "#86EFACFF",
          "light": "#15803DFF"
        }
      },
      "status.warning": {
        "description": "Warning or needs-attention status",
        "values": {
          "dark": "#FDE68AFF",
          "light": "#A16207FF"
        }
      },
      "surface.primary": {
        "values": {
          "dark": "#111827FF",
          "light": "#FFFFFFFF"
        }
      },
      "surface.secondary": {
        "values": {
          "dark": "#1F2937FF",
          "light": "#F1F5F9FF"
        }
      },
      "text.primary": {
        "description": "Primary readable text",
        "values": {
          "dark": "#F8FAFCFF",
          "light": "#0F172AFF"
        }
      },
      "text.secondary": {
        "description": "Secondary readable text",
        "values": {
          "dark": "#CBD5E1FF",
          "light": "#475569FF"
        }
      }
    },
    "cornerRadii": {
      "card": {
        "value": 20
      },
      "control": {
        "value": 10
      }
    },
    "shadows": {
      "card": {
        "value": [
          {
            "blur": 18,
            "color": {
              "dark": "#00000066",
              "light": "#0F172A24"
            },
            "kind": "drop",
            "spread": 0,
            "x": 0,
            "y": 8
          }
        ]
      }
    },
    "spacing": {
      "lg": {
        "value": 24
      },
      "md": {
        "value": 16
      },
      "sm": {
        "value": 8
      },
      "xl": {
        "value": 32
      },
      "xs": {
        "value": 4
      }
    },
    "typography": {
      "body": {
        "value": {
          "fontFamily": "system",
          "fontSize": 16,
          "fontWeight": 400,
          "letterSpacing": 0,
          "lineHeight": 24
        }
      },
      "headline": {
        "value": {
          "fontFamily": "system",
          "fontSize": 28,
          "fontWeight": 700,
          "letterSpacing": -0.4,
          "lineHeight": 34
        }
      }
    }
  }
}
